{
  "name": "@mdehub/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "docs:dev": "pnpm --filter @mdehub/docs dev",
    "docs:build": "turbo run docs:build",
    "playground": "pnpm --filter @mdehub/core --filter @mdehub/react --filter @mdehub/vue build && pnpm --filter @mdehub/playground dev",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "publish:npm": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "tsup": "^8.5.1",
    "turbo": "^2.8.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^3.2.4"
  }
}
